{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "muffle",
  "version": "1.0.0",
  "identifier": "com.iput-object.muffle",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "muffle",
        "width": 1100,
        "height": 680,
        "minWidth": 1100,
        "minHeight": 680,
        "maxWidth": 1100,
        "maxHeight": 680,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "fullscreen": false,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/iput-object/muffle/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5ODJGNTMyMzAwQjI5M0MKUldROEtRc3dNdldDMmMzVDFpalR1NFZNS01kY21hRkt2a1Jzdm8yNllSaFdDSUxxWkZsZG1BRmkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  }
}
